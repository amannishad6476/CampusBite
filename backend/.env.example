# ==============================================================================
# CampusBite Production Configuration (.env.example)
# ==============================================================================

# Application Environment
ENVIRONMENT="production"  # Options: development, staging, production
PROJECT_NAME="CampusBite"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL Production)
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campusbite"

# Security & Authentication (JWT)
# Generate a secure 256-bit key: openssl rand -hex 32
SECRET_KEY="replace_with_a_high_entropy_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# CORS (Allowed frontend web/mobile origins)
# For production, list exact origins without wildcard:
BACKEND_CORS_ORIGINS="https://admin.campusbite.com,http://localhost:5173,http://127.0.0.1:5173"

# Optional Payment Gateway Integration (Razorpay / Stripe)
# Leave blank during offline testing; provide valid gateway credentials in production
PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""

# Optional Maps & Geocoding Services
MAPS_API_KEY=""

# Optional Push Notifications (Firebase FCM / Expo Push)
PUSH_NOTIFICATION_KEY=""
