# Project Configurations
PROJECT_NAME=CampusBite
API_V1_STR=/api/v1

# Security & JWT Tokens
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=supersecretjwtkeychangeinproduction12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=campusbite
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusbite

# CORS Configuration (JSON array of strings)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
