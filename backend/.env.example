# ==============================================================================
# CampusBite Backend Configuration (.env.example)
# ==============================================================================

# General
PROJECT_NAME="CampusBite"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL in production, SQLite for isolated unit testing)
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campusbite"

# Security & Authentication
# Generate a secure 256-bit random key in production: openssl rand -hex 32
SECRET_KEY="replace_with_a_long_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# CORS (Allowed frontend origins)
# Comma-separated list or JSON array of allowed origins (e.g. Admin Web, local dev, mobile)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# Payment Gateway Configuration (Optional - production only)
# Razorpay / Stripe credentials (never commit production keys!)
PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""

# Maps / Location Services (Optional - production only)
MAPS_API_KEY=""

# Push Notifications (Optional - Firebase FCM / Expo)
PUSH_NOTIFICATION_KEY=""
